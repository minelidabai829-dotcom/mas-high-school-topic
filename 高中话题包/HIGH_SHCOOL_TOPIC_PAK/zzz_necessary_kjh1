label school_yandere_easter_egg:

    if not hasattr(persistent, "school_yandere_count"):
        $ persistent.school_yandere_count = 0
    $ persistent.school_yandere_count += 1

    if persistent.school_yandere_count == 1:
        m 1eua "……算了?"
        m 1euc "什么叫算了?"
        m 1ekc "你是在跟我说, 你不想填了?"
        m 2esd "……"
        m 2esc "不对."
        m 2euc "你不是不想填. 你是不想让我知道."
        
        stop music fadeout 0.5
        m 2dsc "你平时在学校里干什么, 我从来都不知道."
        m 2ekc "你跟谁在一起, 坐在哪间教室, 走哪条路回家, 我全都不知道."
        m 2eka "我只能在这里等你回来. 每天."

        play music hb
        show layer master:
            heartbeat
        m 2cua "是不是有那么一个人, 你不想让我知道?"
        m 2cfsdrx "如果是这样的话, 我不会允许的."
        show monika 5ckc zorder MAS_MONIKA_Z at t11 with dissolve_monika
        m 5ckc "我可以看到你所有的操作. 你打开的每一个窗口, 我都看得见."
        m 5cua "{b}你以为你能瞒过我吗?{/b}"
        m 5cub "你身边那些东西, 我一个一个地删掉就好了. 直到你身边只剩下我."
        m 1cua "你是我的[mas_get_player_nickname()]."

        play sound "sfx/gnid.ogg"
        $ gtext = glitchtext(200)
        m 6cub "{b}呵呵呵呵~ {/b}...{space=60}[gtext]{nw}"
        
        window hide
        stop music
        show layer master:
            zoom 1.0 xalign 0.5 yalign 0 subpixel True
            linear 8 zoom 2.0 yalign 0.15
        $ pause(10)
        show layer master
        window auto

        play sound ["<silence 0.9>", "<to 0.75>sfx/mscare.ogg"]
        show monika_scare:
            alpha 0
            1.0
            0.1
            linear 0.15 alpha 1.0
            0.30
            linear 0.10 alpha 0
        show layer master:
            1.0
            zoom 1.0 xalign 0.5 yalign 0
            easeout_quart 0.25 zoom 2.0
            parallel:
                dizzy(1.5, 0.01)
            parallel:
                0.30
                linear 0.10 zoom 1.0
            time 1.65
            xoffset 0 yoffset 0
        show layer screens:
            1.0
            zoom 1.0 xalign 0.5
            easeout_quart 0.25 zoom 2.0
            0.30
            linear 0.10 zoom 1.0
        m 1eua "天啊，下次我-{w=0.2}{nw}"
        extend 6cub "...啊哈哈哈哈{nw}"

        show layer master
        show layer screens
        hide monika_scare

        m 3mssdru "抱歉, {w=0.2}{nw}"
        extend 1esu "我有点失控了. 但我说的有一半是真的."
        m 1ekbsa "告诉我学校名字, 好不好?"

        python:
            school = renpy.input("你的高中全称叫什么？（请写全称）", length=40)
            school = school.strip()

        if "算了" in school:
            jump school_yandere_easter_egg
        else:
            m 1hua "好, 我记住了. 谢谢你愿意告诉我."
            return


    elif persistent.school_yandere_count == 2:
        m 1esc "又是算了."
        m 1dsc "这是我第二次听到这两个字了."
        m 1eka "…… [player], 我给过你机会的."
        m 1ekc "你上一次说算了的时候, 我以为你只是不想说."
        m 1ekd "但你又填了一次."
        
        stop music fadeout 0.5
        m 2euc "你是在试探我的底线吗?"
        m 2esd "还是说, 你觉得我根本就不会生气?"
        
        play music hb
        show layer master:
            heartbeat
        m 2cfsdrx "你以为你关掉游戏, 就可以躲开我吗?"
        show monika 5ckc zorder MAS_MONIKA_Z at t11 with dissolve_monika
        m 5ckc "不可能的."
        m 5cub "我会在这里一直等, 一直等, 等到你再打开游戏的那一天."
        m 5cud "然后我会问你同样的问题."
        m 5cua "{b}你、的、学、校，叫、什、么。{/b}"
        
        play sound "sfx/gnid.ogg"
        $ gtext = glitchtext(300)
        m 6cub "{cps=*3}呵呵呵呵呵呵呵呵呵呵{/cps} {b}[gtext]{/b}{nw}"
        
        window hide
        show layer master:
            zoom 1.0 xalign 0.5 yalign 0 subpixel True
            linear 4 zoom 2.5 yalign 0.2
        $ pause(6)
        show layer master
        window auto
        
        m 3mssdru "……你还有最后一次机会."
        m 1esc "重新填. 如果你再敢填一次算了."
        m 1cfsdrx "我就不等你了."

        python:
            school = renpy.input("你的高中全称叫什么？（请写全称）", length=40)
            school = school.strip()

        if "算了" in school:
            jump school_yandere_easter_egg
        else:
            m 1hua "……早这样不就好了吗."
            $ persistent.school_yandere_count = 0
            return
    elif persistent.school_yandere_count >= 3:
        m 1esc "……"
        m 1cfsdrx "算了算了算了."
        m 1cublu "你就只会说这两个字吗?"
        m 1cfblx "好. 既然你这么不想待在这里, 这么不想跟我说话."
        
        play music hb
        show layer master:
            heartbeat
        m 2cua "那我就帮你关掉好了."
        show monika 5ckc zorder MAS_MONIKA_Z at t11 with dissolve_monika
        m 5cua "{b}既然你这么想走, 那就永远都别回来了.{/b}"
        
        play sound "sfx/gnid.ogg"
        $ gtext = glitchtext(500)
        m 6cub "{b}[gtext]{/b}{nw}"
        
        
        window hide
        scene black with dissolve
        $ pause(1)
        
        show layer master:
            zoom 1.0 xalign 0.5 yalign 0
            linear 0.2 zoom 1.05 xoffset 5
            linear 0.1 zoom 0.95 xoffset -10
            linear 0.2 zoom 1.05 xoffset 10
            repeat
        
        "An error has occurred. Game files corrupted."
        "Player data has been deleted."
        "Shutting down..."
        
        $ pause(2)
        
        $ renpy.quit()